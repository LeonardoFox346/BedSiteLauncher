# 床头钟 Root 模块配置（修改后重启生效）
# 1 启用，0 关闭

# 设为默认桌面
SET_HOME=1

# 授予「最近任务」需要的用量访问
GRANT_USAGE=1

# 授予通知使用权（控制中心读取媒体）
GRANT_NOTIFICATION=1

# 开启无障碍服务（免 Root 锁屏）
ENABLE_A11Y=1

# 加入电池优化白名单（防止后台被杀）
BATTERY_WHITELIST=1

# 停用原生桌面（谨慎：停用后若床头钟被卸载，会没有桌面可用）
DISABLE_STOCK=0

# 需要停用的原生桌面/多任务提供者
STOCK_PKGS="com.android.launcher3 com.google.android.apps.nexuslauncher"
